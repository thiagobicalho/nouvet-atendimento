        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ data: { name: 'Acompanhamento SLA', description: 'Task de acompanhamento de SLA de resposta -- renovada automaticamente enquanto o atendimento aguarda humano; escalonamento ao gestor quando vencida sem atividade do lead.', status: 'open', due_date: $now.plus({ minutes: $('Buscar SLA Config').item.json.sla_resposta_minutos }).toISO(), deal_id: $('Receber Solicitação').item.json.deal_id } }) }}"
      },
