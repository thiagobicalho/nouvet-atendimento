# Credenciais e configurações de ambiente
.env
.env.*
!.env.example
!.env.*.example

# Dependências e caches
node_modules/
.venv/
__pycache__/

# Estado local dos assistentes
.headroom/
.claude/.headroom_wrap_marker.json
.claude/settings.local.json
CLAUDE.local.md
.serena/cache/

# Arquivos do sistema
.DS_Store
Thumbs.db

.claude/.headroom_wrap_owners.json
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
.bmad-loop/archive/
_bmad/render/

# Metadados do Windows/WSL (arquivo baixado da internet)
*:Zone.Identifier

# Dado real de cliente (PII - CPF/RG/telefone/endereço) - nunca versionar
_bmad-output/reference/clientes.csv

# Dados sensiveis do cliente (tenant Microsoft, backup SimplesVet) - nunca versionar
_bmad-output/reference/microsoft/
_bmad-output/reference/simplesvet/
*.bak
*.sql.gz
*.dump

# Transcritos gerados pela bancada de teste (Story 1.4) -- saída de execução local,
# nunca dado de cliente real (telefone/contact_id sintéticos, DDD 00), mas ainda
# assim artefato gerado, não fonte -- nunca versionado.
bancada-teste/transcritos/*
!bancada-teste/transcritos/.gitkeep
