# Copie para .env e preencha com valores reais antes de "docker compose up".
# Nunca commitar o .env preenchido (.gitignore já bloqueia .env/.env.* exceto este
# arquivo) — nenhuma credencial real em texto no repo (AD-2).

# ---------------------------------------------------------------------------
# Postgres — superusuário de bootstrap
# ---------------------------------------------------------------------------
# Usado só para criar os 2 bancos e os 3 papéis nas migrations (0001-0003). Nem o n8n
# nem a aplicação usam este usuário em runtime.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-por-uma-senha-forte

# Nome do banco da aplicação (default do container Postgres; onde as migrations
# 0002/0003 criam as tabelas). Só mude se também ajustar as migrations.
POSTGRES_APP_DB=nouvet_app

# ---------------------------------------------------------------------------
# Postgres — 3 papéis de privilégio mínimo (AD-3)
# ---------------------------------------------------------------------------
# Nomes de banco/papel são fixos nas migrations (nouvet_n8n/nouvet_app,
# n8n_role/app_role/identidade_role) — só a senha de cada papel vem daqui.

# Papel dono do banco interno do n8n (workflows/execuções/credenciais).
POSTGRES_N8N_ROLE_PASSWORD=troque-por-uma-senha-forte

# Papel padrão do banco da aplicação: secretaria_config, secretaria_profissionais,
# n8n_historico_mensagens, n8n_fila_mensagens, n8n_status_atendimento. Nunca tem
# acesso à tabela de identidade cliente/pet.
POSTGRES_APP_ROLE_PASSWORD=troque-por-uma-senha-forte

# Papel restrito só para a tabela de identidade cliente/pet (PII permanente) — mais
# restrito que o papel padrão acima; nunca tem acesso às demais tabelas.
POSTGRES_IDENTIDADE_ROLE_PASSWORD=troque-por-uma-senha-forte

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
# Obrigatória, mínimo 32 caracteres hex, sem fallback nem geração automática (AD-2).
# Gerar com: openssl rand -hex 32
# Perder esta chave depois de credenciais reais salvas no cofre do n8n = credenciais
# irrecuperáveis (mesmo com o volume ./n8n_data intacto).
N8N_ENCRYPTION_KEY=troque-por-uma-chave-hex-com-pelo-menos-32-caracteres

# ---------------------------------------------------------------------------
# Importador standalone do export SimplesVet (Story 1.1, AD-15)
# ---------------------------------------------------------------------------
# Caminho no host (fora deste repositório) onde ficam glo_pessoa.csv, glo_contato.csv
# e vet_animal.csv do export do SimplesVet -- montado só-leitura no serviço `importer`
# (profiles: ["tools"], nunca sobe com "docker compose up" default). Nunca aponte para
# um caminho dentro do repo (NFR-6: nenhum CSV do export entra no versionamento).
SIMPLESVET_EXPORT_HOST_DIR=/caminho/fora-do-repo/para/o/export-simplesvet
